[Unit]
Description=Jarvis authenticated web upstream
After=jarvis-mail.service
[Service]
Type=simple
WorkingDirectory=/docker/jarvis-integration/web
ExecStart=/usr/bin/node scripts/start-hosted.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
