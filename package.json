{
  "name": "jarvis-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "openapi-typescript contracts/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run",
    "build:mock": "tsc -b && vite build --mode mock",
    "build:live": "tsc -b && vite build --mode live --outDir dist-live",
    "start:live": "node scripts/start-live.mjs",
    "test:bridge": "node --test scripts/live-bridge.check.mjs",
    "test:web-login-config": "node --test scripts/web-login-config.check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "msw": "^2.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

